# Conexión a PostgreSQL.
# Local: PostgreSQL instalado en el equipo (servicio). Producción: Prisma Postgres en Vercel.
DATABASE_URL="postgresql://postgres:CONTRASEÑA@localhost:5432/feu?schema=public"

# Clave de Auth.js para cifrar la cookie de sesión. Obligatoria en producción.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="cambiar-en-produccion"

# Segundo factor TOTP para autoridades (ADMIN, COMMISSION). Desactivado por ahora.
# AUTH_MFA_ENABLED="true"
