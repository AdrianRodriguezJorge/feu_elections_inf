# Conexión a PostgreSQL.
# Desarrollo local con Docker:
#   docker run -d --name feu-postgres -e POSTGRES_PASSWORD=feu -e POSTGRES_DB=feu -p 5432:5432 postgres:17
DATABASE_URL="postgresql://feu:feu@localhost:5432/feu?schema=public"

# Secretos de la aplicación (generar con: openssl rand -base64 32)
AUTH_SECRET="cambiar-en-produccion"
# Clave para cifrar los comprobantes de voto.
BALLOT_RECEIPT_KEY="cambiar-en-produccion"
